# DFU-XAI Configuration Template (Placeholders only - Never commit production secrets)

# System & App
ENVIRONMENT=development
APP_NAME="DFU-XAI Research Prototype"
DEBUG=true
PORT=8000
HOST=0.0.0.0

# Security & Authentication
# Generate a secure key in production with: openssl rand -hex 32
SECRET_KEY=change-this-insecure-default-key-for-local-development-only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database Configuration
# Default: SQLite for lightweight zero-dependency local testing
DATABASE_URL=sqlite:///./dfu_xai.db
# For PostgreSQL deployment:
# DATABASE_URL=postgresql://dfu_user:dfu_password@localhost:5432/dfu_xai

# CORS Settings
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Storage Configuration
UPLOAD_DIR=./data/uploads
STORAGE_BACKEND=local
MAX_UPLOAD_SIZE_MB=25

# ML Inference Settings
DEVICE=cpu
MODEL_REGISTRY_PATH=./ml/weights
USE_SYNTHETIC_FALLBACK=true
ENABLE_ONNX_INFERENCE=true

# Clinical Decision Support Notice
CLINICAL_DISCLAIMER="Research decision-support prototype. Not for autonomous diagnosis or treatment. Clinical decisions must be made by qualified healthcare professionals."
